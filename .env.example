# Supabase — salin ke .env.local dan isi dengan nilai project sungguhan.
# Next.js hanya menyertakan variabel berprefix NEXT_PUBLIC_ ke browser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Alias sesuai permintaan prompt. Catatan: Next.js TIDAK membaca VITE_*
# secara otomatis; kode hanya memakainya sebagai fallback di server/SSR.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Mode: "mock" (default) atau "live" setelah kredensial tersedia.
NEXT_PUBLIC_BACKEND_MODE=mock

# HANYA untuk script server/migration. JANGAN pernah pakai prefix NEXT_PUBLIC_
# atau VITE_ dan jangan kirim ke browser.
SUPABASE_SERVICE_ROLE_KEY=
